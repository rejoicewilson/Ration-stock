# Backend only. Local Python loads .env; configure these in Vercel for deployment.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Exact UUID of your newly registered owner account (not its phone/shop number).
OWNER_ACCOUNT_ID=
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ration-stock.vercel.app
# Local HTTP only; Vercel forces secure cookies automatically.
COOKIE_SECURE=false
SUPPORT_WHATSAPP=919447645196

# Subscription test backend. Test and live access are stored separately.
# The checkout UI is opt-in via VITE_SUBSCRIPTION_TEST_UI in frontend env.
# Test-only Preview/local feature gate; defaults off and cannot activate on Vercel Production.
# Enable only while testing the no-plan experience, then set back to false.
SUBSCRIPTION_ACCESS_REQUIRED=false
# Real-money pilot is disabled by default and only works on feature/99-subscription Preview.
# Set both identifiers to the exact signed-in account values. Never enable in Production.
LIVE_PILOT_ENABLED=false
LIVE_PILOT_ACCESS_REQUIRED=false
LIVE_PILOT_FPS_ID=
LIVE_PILOT_MOBILE=
BILLING_MODE=test
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_TEST_WEBHOOK_SECRET
