# Backend only. Local Python loads .env; configure these in Vercel for deployment.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Exact UUID of your newly registered owner account (not its phone/shop number).
OWNER_ACCOUNT_ID=
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ration-stock.vercel.app
# Local HTTP only; Vercel forces secure cookies automatically.
COOKIE_SECURE=false
MAX_ACTIVE_DEVICE_SESSIONS=2
DEVICE_REPLACEMENT_COOLDOWN_DAYS=7
SUPPORT_WHATSAPP=919447645196
