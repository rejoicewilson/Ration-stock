# Backend only. Local Python loads .env; configure these in Vercel for deployment.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Exact UUID of your newly registered owner account (not its phone/shop number).
OWNER_ACCOUNT_ID=
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ration-stock.vercel.app
# Local HTTP only; Vercel forces secure cookies automatically.
COOKIE_SECURE=false
SUPPORT_WHATSAPP=919447645196
# Free access ends at midnight IST on November 1. Must include a timezone.
# An account's database free_until override takes priority over this default.
SUBSCRIPTION_FREE_UNTIL=2026-11-01T00:00:00+05:30
# Real-money checkout. All secrets are backend-only; use matching Live Mode keys.
PAYMENTS_ENABLED=false
BILLING_MODE=live
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
