# Frontend environment template.
# Copy to .env.local, preserving any existing local settings, and restart Vite.
# All VITE_ values are visible in the browser. Only public configuration belongs here.

# Python handles authentication through same-origin /auth routes.
# No frontend Supabase credentials or SMS provider are needed.

# Existing feature endpoints. These match the current defaults.
# Vite proxies these paths to http://127.0.0.1:8000 during local development.
# The deployed app uses its own backend at the same paths.
VITE_API_URL=/count
VITE_TRANSACTIONS_API_URL=/transactions
VITE_STOCK_REGISTER_API_URL=/stock-register
VITE_RO_DETAILS_API_URL=/ro-details
VITE_RO_QUANTITY_DETAILS_API_URL=/ro-quantity-details
VITE_RATION_CARD_DETAILS_API_URL=/ration-card-details

# Do not add backend secrets or database passwords to this file.
