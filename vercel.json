{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    }
  ],
  "routes": [
    {
      "src": "/count",
      "dest": "api/index.py"
    },
    {
      "src": "/fps-stock",
      "dest": "api/index.py"
    },
    {
      "src": "/transactions",
      "dest": "api/index.py"
    },
    {
      "src": "/stock-register",
      "dest": "api/index.py"
    },
    {
      "src": "/ro-details",
      "dest": "api/index.py"
    },
    {
      "src": "/ro-quantity-details",
      "dest": "api/index.py"
    },
    {
      "src": "/ration-card-details",
      "dest": "api/index.py"
    },
    {
      "src": "/docs",
      "dest": "api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "api/index.py"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/manifest.webmanifest"
    },
    {
      "src": "/service-worker.js",
      "dest": "/service-worker.js"
    },
    {
      "src": "/app-icon.svg",
      "dest": "/app-icon.svg"
    },
    {
      "src": "/icon-192.png",
      "dest": "/icon-192.png"
    },
    {
      "src": "/icon-512.png",
      "dest": "/icon-512.png"
    },
    {
      "src": "/favicon.ico",
      "dest": "/icon-192.png"
    },
    {
      "src": "/google6feb6cea2e1c26a3.html",
      "dest": "/google6feb6cea2e1c26a3.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
